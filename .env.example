# Copy to .env and fill in real values. Never commit .env.

# OpenRouter — LLM (gpt-oss-120b via Cerebras/Groq) + Voyage embeddings/reranking
OPENROUTER_API_KEY=

# AssemblyAI — async transcription (ingestion) + realtime streaming STT (voice upgrade)
ASSEMBLYAI_API_KEY=

# ElevenLabs — instant voice cloning + Eleven Flash v2.5 TTS (voice upgrade)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# AWS — S3 media bucket (IAM key scoped to this bucket only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET=syncs-hack-357542024934-ap-southeast-2-an

# Pinecone — vector index (serverless, cosine metric)
PINECONE_API_KEY=
PINECONE_INDEX=alexandria

